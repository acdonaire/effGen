{
  "name": "vscode-effgen",
  "displayName": "effGen",
  "description": "effGen — Efficient Agent Framework: prompt-template completion, run code lens, hover docs",
  "version": "0.2.10",
  "publisher": "effgen",
  "repository": {
    "type": "git",
    "url": "https://github.com/effgen-ai/effgen"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agents",
    "llm",
    "prompt",
    "effgen"
  ],
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/*.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "effgen.runPrompt",
        "title": "effGen: Run Prompt",
        "icon": "$(play)"
      },
      {
        "command": "effgen.showRegistry",
        "title": "effGen: Show Prompt Registry"
      }
    ],
    "configuration": {
      "title": "effGen",
      "properties": {
        "effgen.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of the effGen API server"
        },
        "effgen.defaultModel": {
          "type": "string",
          "default": "cerebras:llama3.1-8b",
          "description": "Default model for running prompts from the editor"
        },
        "effgen.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable prompt-template auto-completion"
        },
        "effgen.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover documentation for prompt templates"
        }
      }
    },
    "languages": [
      {
        "id": "python",
        "extensions": [
          ".py"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
